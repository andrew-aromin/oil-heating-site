---
import { siteConfig } from '../data/siteConfig.js';
---

<section id="contact" class="py-16 sm:py-20 bg-stone-100/80 border-t border-stone-200/80">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl mx-auto">
      <div class="text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900">
          Need Oil or a Hand With Your Burner?
        </h2>
        <p class="mt-2 text-base text-stone-600">
          Leave your details below and one of the Millers will call you right back.
        </p>
      </div>

      <div class="mt-8 rounded-2xl border border-stone-200 bg-white p-6 sm:p-8 shadow-xs">
        <form id="quote-form" class="space-y-4" novalidate>
          <input type="hidden" name="access_key" value={siteConfig.web3FormsAccessKey} />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
          />

          <div
            id="quote-form-errors"
            class="hidden rounded-xl border border-red-300 bg-red-50 p-3.5 text-sm text-red-800"
            role="alert"
          ></div>

          <div
            id="quote-form-success"
            class="hidden rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900"
            role="status"
          >
            <strong>Thank you, neighbor!</strong> We have your message and will give you a call shortly.
          </div>

          <div>
            <label for="customer-name" class="block text-sm font-semibold text-stone-800">
              Your Name
            </label>
            <input
              type="text"
              id="customer-name"
              name="name"
              required
              placeholder="Jane Homeowner"
              class="mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm text-stone-900 focus:border-red-800 focus:outline-none focus:ring-2 focus:ring-red-800/20"
            />
          </div>

          <div>
            <label for="customer-email" class="block text-sm font-semibold text-stone-800">
              Email Address
            </label>
            <input
              type="email"
              id="customer-email"
              name="email"
              required
              autocomplete="email"
              placeholder="jane@example.com"
              class="mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm text-stone-900 focus:border-red-800 focus:outline-none focus:ring-2 focus:ring-red-800/20"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="customer-phone" class="block text-sm font-semibold text-stone-800">
                Phone Number
              </label>
              <input
                type="tel"
                id="customer-phone"
                name="phone"
                required
                placeholder="(555) 234-5678"
                class="mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm text-stone-900 focus:border-red-800 focus:outline-none focus:ring-2 focus:ring-red-800/20"
              />
            </div>

            <div>
              <label for="customer-zip" class="block text-sm font-semibold text-stone-800">
                ZIP Code
              </label>
              <input
                type="text"
                id="customer-zip"
                name="zip"
                required
                placeholder="01701"
                class="mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm text-stone-900 focus:border-red-800 focus:outline-none focus:ring-2 focus:ring-red-800/20"
              />
            </div>
          </div>

          <div>
            <label for="service-type" class="block text-sm font-semibold text-stone-800">
              How Can We Help?
            </label>
            <select
              id="service-type"
              name="serviceType"
              required
              class="mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm text-stone-900 focus:border-red-800 focus:outline-none focus:ring-2 focus:ring-red-800/20"
            >
              <option value="delivery">
                Heating Oil Delivery
              </option>
              <option value="emergency">
                24/7 Emergency Burner Repair
              </option>
              <option value="installation">
                Boiler, Tank, or Tune-Up Estimate
              </option>
            </select>
          </div>

          <button
            type="submit"
            id="quote-submit-btn"
            class="w-full inline-flex items-center justify-center rounded-full bg-red-800 px-6 py-3.5 text-base font-semibold text-amber-50 shadow-sm hover:bg-red-700 transition cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Send to Our Family Dispatch
          </button>
        </form>
      </div>

      <p class="mt-5 text-center text-sm text-stone-600">
        Or call <a href={siteConfig.phoneHref} class="font-bold text-red-800 underline">{siteConfig.phoneDisplay}</a> anytime for 24/7 dispatch.
      </p>
    </div>
  </div>
</section>

<script>
  import {
    resolveServiceType,
    validateQuoteRequest,
    buildWeb3FormsPayload,
    submitQuoteToWeb3Forms,
  } from '../utils/uiLogic.js';

  const contactSection = document.getElementById('contact');
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const errorBox = document.getElementById('quote-form-errors');
  const successBox = document.getElementById('quote-form-success');
  const serviceSelect = document.getElementById('service-type') as HTMLSelectElement | null;
  const submitBtn = document.getElementById('quote-submit-btn') as HTMLButtonElement | null;

  document.querySelectorAll('[data-service-link]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const rawService = el.getAttribute('data-service-link') || el.getAttribute('href');
      const resolvedService = resolveServiceType(rawService);
      if (serviceSelect && resolvedService) {
        serviceSelect.value = resolvedService;
      }
      if (contactSection) {
        contactSection.scrollIntoView({ behavior: 'smooth' });
        history.replaceState(null, '', '#contact');
      }
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !errorBox || !successBox) return;

    const formData = new FormData(form);
    const name = String(formData.get('name') || '');
    const email = String(formData.get('email') || '');
    const phone = String(formData.get('phone') || '');
    const zip = String(formData.get('zip') || '');
    const serviceType = String(formData.get('serviceType') || '');
    const accessKey = String(formData.get('access_key') || '');
    const botcheck = formData.get('botcheck') !== null;

    const validation = validateQuoteRequest({ name, email, phone, zip, serviceType });

    if (!validation.valid) {
      successBox.classList.add('hidden');
      errorBox.innerHTML = validation.errors.map((err) => `<div>• ${err}</div>`).join('');
      errorBox.classList.remove('hidden');
      return;
    }

    errorBox.classList.add('hidden');
    successBox.classList.add('hidden');

    const defaultBtnText = submitBtn?.textContent || 'Send to Our Family Dispatch';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }

    const payload = buildWeb3FormsPayload({ name, email, phone, zip, serviceType, botcheck }, accessKey);
    const result = await submitQuoteToWeb3Forms(payload);

    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = defaultBtnText;
    }

    if (!result.ok) {
      errorBox.innerHTML = `<div>• ${result.message}</div>`;
      errorBox.classList.remove('hidden');
      return;
    }

    successBox.classList.remove('hidden');
    form.reset();
  });
</script>
