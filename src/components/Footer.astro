---
import { siteConfig } from '../data/siteConfig.js';
import { withBase } from '../utils/uiLogic.js';
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="bg-black text-neutral-300 border-t border-neutral-800">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-3 text-center sm:text-left">
        <img
          src={withBase(siteConfig.logo, base)}
          alt={`${siteConfig.brandName} logo`}
          class="h-8 w-8 rounded-full object-cover"
        />
        <span class="font-sans font-extrabold uppercase tracking-wide text-white">
          {siteConfig.brandName}
        </span>
        <span class="hidden sm:inline text-neutral-600">•</span>
        <a href={siteConfig.phoneHref} class="text-[#1ba1e2] hover:underline font-bold">
          {siteConfig.phoneDisplay}
        </a>
      </div>

      <div class="flex items-center gap-6">
        {siteConfig.navLinks.map((link) => (
          <a href={withBase(link.href, base)} class="text-neutral-400 hover:text-[#1ba1e2] transition">
            {link.label}
          </a>
        ))}
      </div>

      <p class="text-xs text-neutral-500">
        &copy; {currentYear} {siteConfig.brandName}
      </p>
    </div>
  </div>
</footer>
