---
import { siteConfig } from '../data/siteConfig.js';
import { withBase } from '../utils/uiLogic.js';
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="bg-stone-900 text-stone-300 border-t border-stone-800">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
        <span class="font-serif font-bold text-amber-50">
          {siteConfig.brandName}
        </span>
        <span class="hidden sm:inline text-stone-600">•</span>
        <a href={siteConfig.phoneHref} class="text-amber-300 hover:underline font-medium">
          {siteConfig.phoneDisplay}
        </a>
      </div>

      <div class="flex items-center gap-6">
        {siteConfig.navLinks.map((link) => (
          <a href={withBase(link.href, base)} class="text-stone-400 hover:text-amber-200 transition">
            {link.label}
          </a>
        ))}
      </div>

      <p class="text-xs text-stone-500">
        &copy; {currentYear} {siteConfig.brandName} (Est. {siteConfig.establishedYear})
      </p>
    </div>
  </div>
</footer>
