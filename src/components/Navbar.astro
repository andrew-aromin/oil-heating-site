---
import { siteConfig } from '../data/siteConfig.js';
import { withBase } from '../utils/uiLogic.js';
const base = import.meta.env.BASE_URL;
---

<header class="sticky top-0 z-50 w-full border-b border-neutral-800 bg-black/95 text-white backdrop-blur-md">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main Navigation">
    <div class="flex h-20 items-center justify-between gap-4">
      <!-- Dan McKay Logo & Brand Name -->
      <a href={withBase('/', base)} class="flex items-center gap-3 focus:outline-none">
        <img
          src={withBase(siteConfig.logo, base)}
          alt={`${siteConfig.brandName} logo`}
          class="h-12 w-12 rounded-full object-cover shrink-0"
        />
        <div class="flex flex-col leading-tight">
          <span class="font-sans text-base sm:text-lg font-extrabold uppercase tracking-wider text-white">
            {siteConfig.brandName}
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex md:items-center md:gap-8">
        {siteConfig.navLinks.map((link) => (
          <a
            href={withBase(link.href, base)}
            class="text-sm font-semibold uppercase tracking-wide text-neutral-200 hover:text-[#1ba1e2] transition-colors"
          >
            {link.label}
          </a>
        ))}
        <a
          href={siteConfig.phoneHref}
          class="inline-flex items-center rounded-full bg-[#e06336] px-4 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-[#c95328] transition"
        >
          Call {siteConfig.phoneDisplay}
        </a>
      </div>

      <!-- Mobile Hamburger Toggle -->
      <div class="flex items-center md:hidden">
        <button
          id="mobile-menu-toggle"
          type="button"
          class="inline-flex md:hidden h-10 w-10 items-center justify-center rounded-lg border border-neutral-700 bg-neutral-900 text-neutral-200 hover:bg-neutral-800 focus:outline-none focus:ring-2 focus:ring-[#1ba1e2]"
          aria-controls="navbar-collapse"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
        >
          <svg id="menu-icon-open" class="h-5 w-5 block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="h-5 w-5 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Collapsible Drawer (< md) -->
    <div id="navbar-collapse" class="hidden md:hidden border-t border-neutral-800 py-3">
      <div class="flex flex-col space-y-1">
        {siteConfig.navLinks.map((link) => (
          <a
            href={withBase(link.href, base)}
            data-mobile-nav-link
            class="rounded-lg px-3 py-2 text-base font-medium text-neutral-100 hover:bg-neutral-900 hover:text-[#1ba1e2] transition"
          >
            {link.label}
          </a>
        ))}
        <a
          href={siteConfig.phoneHref}
          class="mt-2 inline-flex items-center justify-center rounded-lg bg-[#e06336] px-4 py-2.5 text-sm font-bold uppercase tracking-wider text-white hover:bg-[#c95328] transition"
        >
          Call {siteConfig.phoneDisplay}
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const collapseMenu = document.getElementById('navbar-collapse');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('[data-mobile-nav-link]');

  function setMenuOpen(isOpen: boolean) {
    if (!toggleBtn || !collapseMenu || !iconOpen || !iconClose) return;
    toggleBtn.setAttribute('aria-expanded', String(isOpen));
    collapseMenu.classList.toggle('hidden', !isOpen);
    iconOpen.classList.toggle('hidden', isOpen);
    iconClose.classList.toggle('hidden', !isOpen);
  }

  toggleBtn?.addEventListener('click', () => {
    const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!expanded);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
</script>
