---
import { siteConfig } from '../data/siteConfig.js';
import { withBase } from '../utils/uiLogic.js';
const { about } = siteConfig;
const base = import.meta.env.BASE_URL;
---

<section id="about" class="py-16 sm:py-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Column: Framed Family Photo & Caption -->
      <div class="lg:col-span-6">
        <figure class="rounded-2xl border border-neutral-200 bg-slate-50 p-3 sm:p-4 shadow-xs">
          <div class="overflow-hidden rounded-xl bg-neutral-200">
            <img
              src={withBase(about.image, base)}
              alt={about.imageAlt}
              class="w-full h-auto aspect-16/10 sm:aspect-4/3 object-cover object-center"
              loading="eager"
            />
          </div>
          {about.imageCaption && (
            <figcaption class="mt-3 px-2 text-center text-sm text-neutral-600">
              {about.imageCaption}
            </figcaption>
          )}
        </figure>
      </div>

      <!-- Right Column: Easy-to-Read Family Bio -->
      <div class="lg:col-span-6">
        <div class="max-w-prose">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center rounded-full bg-black px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#1ba1e2]">
              {about.eyebrow}
            </span>
            {about.experienceBadge && (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#e06336] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <span>{about.experienceBadge}</span>
              </span>
            )}
          </div>

          <h1 class="mt-4 font-sans text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 leading-tight">
            {about.heading}
          </h1>

          <div class="mt-6 space-y-4 text-base sm:text-lg text-neutral-700 leading-relaxed">
            {about.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <div class="mt-8 pt-2">
            <a
              href={withBase(about.ctaHref, base)}
              class="inline-flex items-center gap-2 text-base font-bold text-[#e06336] hover:text-[#c95328] underline underline-offset-4 transition"
            >
              <span>{about.ctaLabel}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
