---
import { siteConfig } from '../data/siteConfig.js';
---

<section id="services" class="py-16 sm:py-20 bg-[#faf7f2]">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900">
        How Our Family Helps Yours
      </h2>
      <p class="mt-2 text-base text-stone-600">
        Simple, honest home heating care for our neighbors since {siteConfig.establishedYear}.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
      {siteConfig.services.map((service) => (
        <article class="rounded-2xl border border-stone-200/90 bg-white p-7 text-center shadow-xs">
          <div class="mx-auto inline-flex h-12 w-12 items-center justify-center rounded-full bg-amber-100 text-red-800">
            {service.id === 'delivery' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 2C12 2 6 8.8 6 13.5C6 17.09 8.69 20 12 20C15.31 20 18 17.09 18 13.5C18 8.8 12 2 12 2Z" />
              </svg>
            )}
            {service.id === 'emergency' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
            {service.id === 'installation' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            )}
          </div>

          <h3 class="mt-4 font-serif text-xl font-bold text-stone-900">
            {service.title}
          </h3>

          <p class="mt-2 text-sm sm:text-base text-stone-600 leading-relaxed">
            {service.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
