---
import { siteConfig } from '../data/siteConfig.js';
---

<!-- Full-Width Orange Service Strip from Flyer -->
<div class="bg-[#e06336] text-white py-5 px-4 shadow-sm">
  <div class="container mx-auto text-center">
    <p class="font-sans text-lg sm:text-xl md:text-2xl font-bold tracking-wide">
      {siteConfig.valueProposition.banner}
    </p>
  </div>
</div>

<section id="services" class="py-16 sm:py-20 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <!-- 3 Core Heating & Cooling Services -->
    <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
      {siteConfig.services.map((service) => (
        <article class="rounded-2xl border border-neutral-200 bg-slate-50/70 p-7 text-center shadow-xs hover:border-[#1ba1e2] transition">
          <div class="mx-auto inline-flex h-12 w-12 items-center justify-center rounded-full bg-black text-[#1ba1e2]">
            {service.id === 'service' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#e06336]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 2C12 2 6 8.8 6 13.5C6 17.09 8.69 20 12 20C15.31 20 18 17.09 18 13.5C18 8.8 12 2 12 2Z" />
              </svg>
            )}
            {service.id === 'installation' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#1ba1e2]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            )}
            {service.id === 'maintenance' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#e06336]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
          </div>

          <h3 class="mt-4 font-sans text-xl font-extrabold text-neutral-900">
            {service.title}
          </h3>

          <p class="mt-2 text-sm sm:text-base text-neutral-600 leading-relaxed">
            {service.description}
          </p>
        </article>
      ))}
    </div>

    <!-- Bottom Flyer Tagline -->
    <div class="mt-16 max-w-3xl mx-auto text-center px-2">
      <p class="font-sans text-2xl sm:text-3xl md:text-4xl font-extrabold italic text-black leading-snug">
        As a small business, we treat our customers like{' '}
        <span class="font-script not-italic font-normal text-3xl sm:text-4xl md:text-5xl text-[#1ba1e2]">family.</span>{' '}
        Your{' '}
        <span class="font-script not-italic font-normal text-3xl sm:text-4xl md:text-5xl text-[#1ba1e2]">comfort</span>{' '}
        matters to us!
      </p>
    </div>
  </div>
</section>
