---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/siteConfig.js';
import { withBase } from '../utils/uiLogic.js';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.brandName} | Keeping Your Home Comfortable Year-Round`,
  description = `${siteConfig.brandName} — ${siteConfig.valueProposition.lead} ${siteConfig.valueProposition.highlight}`,
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg', base)} />
    <link rel="icon" href={withBase('/favicon.ico', base)} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-neutral-900">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
